<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/drawnight_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lottery_nav_drawnight"
                android:textColor="@color/lottery_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/drawnight_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="@color/lottery_text_secondary"
                android:textSize="14sp" />

            <!-- 空闲态 -->
            <TextView
                android:id="@+id/section_idle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:textColor="@color/lottery_text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_start_picking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="48dp"
                android:text="@string/lottery_start_picking" />

            <!-- 出票态:聚光灯(D10=A,一次只演一位;LLM 流式在 T8 接入) -->
            <LinearLayout
                android:id="@+id/section_picking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/picking_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/lottery_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/picking_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/lottery_text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/picking_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/lottery_thinking"
                    android:textColor="@color/lottery_text_secondary"
                    android:textSize="22sp" />

                <LinearLayout
                    android:id="@+id/picking_done"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 锁定态:D14 录入(回显确认 + 即时校验 + 可清空重录) -->
            <LinearLayout
                android:id="@+id/section_locked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/locked_tickets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/lottery_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/lottery_entry_hint"
                    android:textColor="@color/lottery_text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/red_0"
                        style="@style/DrawNightEntry" />

                    <EditText
                        android:id="@+id/red_1"
                        style="@style/DrawNightEntry" />

                    <EditText
                        android:id="@+id/red_2"
                        style="@style/DrawNightEntry" />

                    <EditText
                        android:id="@+id/red_3"
                        style="@style/DrawNightEntry" />

                    <EditText
                        android:id="@+id/red_4"
                        style="@style/DrawNightEntry" />

                    <EditText
                        android:id="@+id/red_5"
                        style="@style/DrawNightEntry" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <EditText
                        android:id="@+id/blue_entry"
                        style="@style/DrawNightEntry"
                        android:backgroundTint="@color/lottery_hit_segment" />
                </LinearLayout>

                <TextView
                    android:id="@+id/entry_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/lottery_badge_worse"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_confirm_entry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:enabled="false"
                    android:minHeight="48dp"
                    android:text="@string/lottery_entry_confirm" />

                <Button
                    android:id="@+id/btn_clear_entry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@android:color/transparent"
                    android:minHeight="48dp"
                    android:text="@string/lottery_entry_clear"
                    android:textColor="@color/lottery_text_secondary" />
            </LinearLayout>

            <!-- 结算态 -->
            <LinearLayout
                android:id="@+id/section_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/result_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btn_next_period"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="48dp"
                    android:text="@string/lottery_next_period" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</layout>

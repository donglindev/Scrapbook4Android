<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lottery_nav_ledger"
            android:textColor="@color/lottery_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="回放账本 · K=6 · 阈值 α/6≈0.0083 · *一/二等奖按假设值计"
            android:textColor="@color/lottery_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="live 赛季账本"
            android:textColor="@color/lottery_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/live_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="回放判决表(JVM 全季)"
            android:textColor="@color/lottery_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ledger_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="徽章图例:✕灰=与随机无差异 · ▼橙红=显著更差 · ⚠黄=数据警报(结果异常请查数据与流程) · …虚线灰=样本不足(live&lt;30 期)"
            android:textColor="@color/lottery_text_secondary"
            android:textSize="11sp" />

        <!-- R9:免责声明条常驻底部 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/lottery_surface"
            android:lineSpacingExtra="2dp"
            android:padding="10dp"
            android:text="@string/lottery_disclaimer"
            android:textColor="@color/lottery_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</layout>

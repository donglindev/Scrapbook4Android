<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ledger_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/lottery_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ledger_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ledger_roi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ledger_p"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/lottery_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 7 段命中分布(6 红 … 0 红),高度 ∝ 计数;TD3 升级 lib_views 式自定义 View -->
        <LinearLayout
            android:id="@+id/ledger_hit_bar"
            android:layout_width="80dp"
            android:layout_height="10dp"
            android:layout_marginStart="10dp"
            android:background="@color/lottery_surface"
            android:orientation="horizontal" />
    </LinearLayout>
</layout>

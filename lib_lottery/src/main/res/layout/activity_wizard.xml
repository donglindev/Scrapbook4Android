<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="赛季设置向导"
                android:textColor="@color/lottery_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wizard_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="1/3"
                android:textColor="@color/lottery_text_secondary"
                android:textSize="13sp" />

            <!-- 步骤 1:建赛季(D7) -->
            <LinearLayout
                android:id="@+id/step1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="赛季名:S1(默认)"
                    android:textColor="@color/lottery_text_primary"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="live 记录起始期(可改,默认为历史最新期的下一期):"
                    android:textColor="@color/lottery_text_secondary"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/start_period"
                    android:layout_width="160dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/lottery_surface"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="7"
                    android:textColor="@color/lottery_text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="live 记录从此期开始,JVM 回放不受影响。"
                    android:textColor="@color/lottery_text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/step1_next"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="48dp"
                    android:text="下一步" />
            </LinearLayout>

            <!-- 步骤 2:模型下载(可跳过,D7) -->
            <LinearLayout
                android:id="@+id/step2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="模型下载(约 1.5GB + 2GB,建议 Wi-Fi)\nLLM 军师 ×3 与 VLM 读图需要;跳过则仅 JVM 六选手参赛。"
                    android:textColor="@color/lottery_text_secondary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/step2_download"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="48dp"
                    android:text="前往模型管理页" />

                <Button
                    android:id="@+id/step2_skip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@android:color/transparent"
                    android:minHeight="48dp"
                    android:text="稍后下载,下一步"
                    android:textColor="@color/lottery_text_secondary" />
            </LinearLayout>

            <!-- 步骤 3:完成 -->
            <LinearLayout
                android:id="@+id/step3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/step3_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/lottery_text_primary"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/step3_done"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="48dp"
                    android:text="进入竞技场" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</layout>

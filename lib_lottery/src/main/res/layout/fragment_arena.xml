<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/arena_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lottery_nav_arena"
            android:textColor="@color/lottery_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/arena_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="JVM 走前回放判决表 · K=6 · 阈值 α/6≈0.0083"
            android:textColor="@color/lottery_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/arena_skeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/lottery_replay_skeleton"
            android:textColor="@color/lottery_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/arena_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>
</layout>

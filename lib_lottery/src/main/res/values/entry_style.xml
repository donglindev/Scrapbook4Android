<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 开奖号录入格:6 红 + 1 蓝,即时校验(D14) -->
    <style name="DrawNightEntry">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@color/lottery_surface</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">2</item>
        <item name="android:textColor">@color/lottery_text_primary</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>
